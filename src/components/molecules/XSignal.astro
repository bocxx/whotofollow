---
/**
 * XSignal — wat de X-selectie over een account weet: of we het rechtstreeks
 * volgen, welk deel van de posts over AI gaat en hoe vaak een post uitschoot.
 * Bron: het veld `x` uit de NewsFlux-export (src/x_selectie.py). Toont niets
 * voor profielen zonder dat veld.
 */
import type { Creator } from '../../types/creator';
import type { Locale } from '../../i18n/messages';
import { formatFactor, formatShare, xCopy, TOON_X_CIJFERS } from '../../lib/x';

interface Props { creator: Creator; locale?: Locale; }
const { creator, locale = 'nl' } = Astro.props;
const x = creator.x;
const c = xCopy[locale];
---
{x && (
  <section class="x-signal">
    <h2>{c.detailHeading}</h2>
    <dl class="dl-grid">
      {TOON_X_CIJFERS && x.ai_aandeel != null && <Fragment><dt>{c.share}</dt><dd class="mono">{formatShare(x.ai_aandeel)}</dd></Fragment>}
      {TOON_X_CIJFERS && <Fragment><dt>{c.hits}</dt><dd class="mono">{x.uitschieters_30d}</dd></Fragment>}
      <dt>{c.followed}</dt><dd>{x.gevolgd ? c.yes : c.no}</dd>
    </dl>
    {x.beste_post && (
      <p class="x-signal__post">
        <a href={x.beste_post.url} target="_blank" rel="noopener noreferrer">{c.bestPost}</a>
        {TOON_X_CIJFERS && <span class="mono"> · {formatFactor(x.beste_post.factor, locale)}</span>}
        <span class="x-signal__text">{x.beste_post.tekst}</span>
      </p>
    )}
    {TOON_X_CIJFERS && <p class="x-signal__note">{c.method}</p>}
  </section>
)}

<style>
  .x-signal { margin-bottom: var(--space-8); }
  .x-signal h2 { font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .x-signal__post { margin: var(--space-4) 0 0; font-size: var(--text-sm); color: var(--text-secondary); }
  .x-signal__post a { color: var(--primary-bright); }
  .x-signal__text { display: block; margin-top: var(--space-1); color: var(--text-muted); overflow-wrap: anywhere; }
  .x-signal__note { margin: var(--space-3) 0 0; font-size: var(--text-xs); color: var(--text-muted); max-width: 640px; }
</style>
